{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 tools/build.py",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "redirects": [
    { "source": "/Final", "destination": "/", "permanent": true },
    { "source": "/Final/index.html", "destination": "/", "permanent": true },
    { "source": "/Final/level2", "destination": "/level2", "permanent": true },
    { "source": "/Final/level2/index.html", "destination": "/level2", "permanent": true },
    { "source": "/level2/index.html", "destination": "/level2", "permanent": true }
  ]
}
